# ---------------------------------------------------------------- core
SCOREBOARD_ENV=dev
SCOREBOARD_SECRET_KEY=change-me-in-production-use-32-plus-random-bytes

# ---------------------------------------------------------------- database
POSTGRES_USER=scoreboard
POSTGRES_PASSWORD=scoreboard
POSTGRES_DB=scoreboard_dev
DATABASE_URL=postgresql+psycopg://scoreboard:scoreboard@db:5432/scoreboard_dev

# ---------------------------------------------------------------- secrets at rest
# Fernet key used to encrypt per-organization source credentials.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCOREBOARD_ENCRYPTION_KEY=

# ---------------------------------------------------------------- optional live Tableau smoke test
# Leave blank for normal development. Tests run against recorded fixtures.
TABLEAU_SERVER=
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
