# A shell script checked out on Windows and copied to a Raspberry Pi is the
# classic way to produce a dark television: `\r\n` line endings make the kernel
# read the shebang as `/usr/bin/env bash\r`, and the only symptom is
#
#     /usr/local/bin/scoreboard-kiosk: bad interpreter: no such file or directory
#
# which says nothing about line endings to whoever is standing in front of the
# screen. Force LF in the working tree everywhere, whatever `core.autocrlf`
# happens to be set to on the machine that cloned this.
.gitattributes  text eol=lf
.gitignore      text eol=lf
*.sh            text eol=lf
*.service       text eol=lf
*.desktop       text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Everything the server or a test reads by content, so a checkout on one
# platform and a run on another cannot disagree about a byte.
*.py            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.csv           text eol=lf
*.toml          text eol=lf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
